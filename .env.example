# Copy to .env and adjust. The application reads the process environment;
# Docker Compose and systemd can load this file for you.
# Every variable is optional except where a production deployment needs auth.

# -- Runtime -------------------------------------------------------------
SENTINELIQ_ENV=development            # development | test | production
HOST=127.0.0.1                        # use 0.0.0.0 inside containers
PORT=8081

# -- Storage -------------------------------------------------------------
# json (default, single file), sqlite (containers), postgres (serverless)
SENTINELIQ_STORAGE=json
SENTINELIQ_DATA_FILE=data/incidents.json
SENTINELIQ_SQLITE_PATH=data/sentineliq.db
# Required only when SENTINELIQ_STORAGE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -- Authentication and tenants -----------------------------------------
# Format: key:role:tenant, comma-separated. Roles: viewer, responder, admin.
# Keys must be at least 12 characters. Leave empty to run without auth
# (acceptable on localhost only).
# SENTINELIQ_API_KEYS=change-me-viewer-key:viewer:default,change-me-responder-key:responder:default,change-me-admin-key:admin:default
# Role for requests without a key: disabled | viewer | responder | admin.
# Defaults: admin when no keys are set (local), disabled when keys are set.
# viewer makes a public instance keyless and read-only.
# SENTINELIQ_ANONYMOUS_ROLE=viewer
SENTINELIQ_AUTH_REQUIRED=false
SENTINELIQ_DEFAULT_TENANT=default

# -- HTTP behaviour ------------------------------------------------------
SENTINELIQ_RATE_LIMIT_RPM=120         # 0 disables rate limiting
SENTINELIQ_MAX_BODY_BYTES=262144
SENTINELIQ_REQUEST_TIMEOUT=15
SENTINELIQ_CORS_ORIGINS=              # comma-separated origins, or * (avoid in production)
SENTINELIQ_TLS=true                   # set when a TLS-terminating proxy is in front

# -- Workflows -----------------------------------------------------------
SENTINELIQ_DEDUP_WINDOW_SECONDS=900
SENTINELIQ_NOTIFY_WEBHOOK_URL=        # Slack-compatible or generic JSON webhook
SENTINELIQ_NOTIFY_MIN_PRIORITY=P2     # notify for P1..this priority
SENTINELIQ_CRON_SECRET=               # enables POST/GET /v1/cron/tick when set

# -- Scoring and demo data ----------------------------------------------
SENTINELIQ_WEIGHTS_FILE=config/weights.json
SENTINELIQ_PLAYBOOKS_FILE=config/playbooks.json
SENTINELIQ_AUTO_SEED=false            # seed demo incidents when the store is empty

# -- Observability -------------------------------------------------------
SENTINELIQ_LOG_FORMAT=text            # text | json (json is default in production)
SENTINELIQ_LOG_LEVEL=INFO
SENTRY_DSN=                           # optional, enables error reporting
