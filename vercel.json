{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/prepare_vercel.py",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].py": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "{config/**,data/**,src/**}"
    },
    "src/asgi.py": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "{config/**,data/**,src/**}"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/v1/health" },
    { "source": "/ready", "destination": "/api/v1/ready" },
    { "source": "/openapi.json", "destination": "/api/openapi.json" },
    { "source": "/docs", "destination": "/api/docs" },
    { "source": "/v1/:match*", "destination": "/api/v1/:match*" }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/tick",
      "schedule": "15 6 * * *"
    }
  ]
}
